
`timescale 1ns/1ps

module fall_detector_tb;

    reg clk;
    reg resetn;

    reg signed [15:0] ax;
    reg signed [15:0] ay;
    reg signed [15:0] az;

    reg sample_valid;

    wire free_fall;
    wire impact;
    wire fall_detected;
    wire [31:0] magnitude_mg;

    integer errors;

    // 100 MHz test clock: 10 ns period
    always #5 clk = ~clk;

    // Device under test
    fall_detector #(
        .ONE_G(16384),
        .FREE_FALL_G(4915),
        .IMPACT_G(24576),
        .HOLD_CYCLES(20)
    ) dut (
        .clk(clk),
        .resetn(resetn),
        .accel_x(ax),
        .accel_y(ay),
        .accel_z(az),
        .sample_valid(sample_valid),
        .free_fall(free_fall),
        .impact(impact),
        .fall_detected(fall_detected),
        .magnitude_mg(magnitude_mg)
    );

    // Send one acceleration sample.
    // This task is suitable for checks of persistent outputs.
    task sample;
        input integer x;
        input integer y;
        input integer z;
        begin
            @(negedge clk);
            ax = x;
            ay = y;
            az = z;
            sample_valid = 1'b1;

            @(negedge clk);
            sample_valid = 1'b0;

            repeat (2) @(negedge clk);
        end
    endtask

    initial begin
        clk = 1'b0;
        resetn = 1'b0;

        ax = 0;
        ay = 0;
        az = 0;
        sample_valid = 1'b0;

        errors = 0;

        $display("----------------------------------------");
        $display(" FALL DETECTOR TESTBENCH");
        $display("----------------------------------------");

        // Apply reset
        repeat (3) @(negedge clk);
        resetn = 1'b1;
        repeat (2) @(negedge clk);

        // TEST 1: Normal acceleration
        $display("TEST 1: Normal acceleration");

        sample(0, 0, 16384);

        if (magnitude_mg == 1000) begin
            $display("PASS: Magnitude = %0d mg", magnitude_mg);
        end else begin
            $display("FAIL: Expected 1000 mg, got %0d mg",
                     magnitude_mg);
            errors = errors + 1;
        end

        if (free_fall == 1'b0) begin
            $display("PASS: No free-fall indication");
        end else begin
            $display("FAIL: Unexpected free-fall indication");
            errors = errors + 1;
        end

        // TEST 2: Free fall
        $display("TEST 2: Free fall");

        sample(0, 0, 0);

        if (free_fall == 1'b1) begin
            $display("PASS: Free fall detected");
        end else begin
            $display("FAIL: Free fall not detected");
            errors = errors + 1;
        end

        // TEST 3: Impact after free fall
        // Check impact before the one-cycle pulse disappears.
        $display("TEST 3: Impact after free fall");

        @(negedge clk);
        ax = 30000;
        ay = 0;
        az = 0;
        sample_valid = 1'b1;

        @(posedge clk);
        #1;

        if (impact === 1'b1) begin
            $display("PASS: Impact pulse detected");
        end else begin
            $display("FAIL: Impact pulse not detected");
            errors = errors + 1;
        end

        if (fall_detected === 1'b1) begin
            $display("PASS: Fall alarm asserted");
        end else begin
            $display("FAIL: Fall alarm not asserted");
            errors = errors + 1;
        end

        @(negedge clk);
        sample_valid = 1'b0;
        repeat (2) @(negedge clk);

        // TEST 4: Impact without prior free fall
        $display("TEST 4: Impact without preceding free fall");

        // Reset detector state before the test.
        resetn = 1'b0;
        repeat (3) @(negedge clk);

        ax = 0;
        ay = 0;
        az = 0;
        sample_valid = 1'b0;

        resetn = 1'b1;
        repeat (2) @(negedge clk);

        // Confirm no fall alarm after reset.
        sample(30000, 0, 0);

        if (fall_detected === 1'b0) begin
            $display("PASS: No false fall alarm");
        end else begin
            $display("FAIL: False fall alarm detected");
            errors = errors + 1;
        end

        // Final result
        $display("----------------------------------------");

        if (errors == 0) begin
            $display("ALL TESTS PASSED");
        end else begin
            $display("TESTS FAILED: %0d error(s)", errors);
        end

        $display("----------------------------------------");

        $finish;
    end

endmodule